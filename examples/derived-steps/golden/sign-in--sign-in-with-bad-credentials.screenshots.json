{
  "bundleDirs": ["sign-in--sign-in-with-bad-credentials"],
  "viewport": { "width": 800, "height": 600 },
  "minBytes": 2000,
  "highlights": [
    null,
    ["outline", "clickDot"],
    ["outline"],
    ["outline", "clickDot"],
    null
  ],
  "steps": [
    {
      "action": "Open http://127.0.0.1:4321/",
      "moment": "after",
      "probes": [
        { "name": "home marker", "x": 400, "y": 140, "rgb": [0, 85, 255] }
      ]
    },
    {
      "action": "Click the **Sign in** link",
      "moment": "action",
      "probes": [
        { "name": "home marker", "x": 400, "y": 140, "rgb": [0, 85, 255] },
        { "name": "outline", "at": "outline", "rgb": [255, 0, 128] },
        { "name": "click dot", "at": "clickPoint", "rgb": [255, 0, 128] }
      ]
    },
    {
      "action": "Type **demo-user** into **Username**",
      "moment": "action",
      "probes": [
        { "name": "login marker", "x": 400, "y": 140, "rgb": [255, 136, 0] },
        {
          "name": "empty Username field",
          "at": "elementBoxCenter",
          "rgb": [255, 255, 255]
        },
        { "name": "outline", "at": "outline", "rgb": [255, 0, 128] }
      ]
    },
    {
      "action": "Click the **Submit bad credentials** button",
      "moment": "action",
      "probes": [
        { "name": "login marker", "x": 400, "y": 140, "rgb": [255, 136, 0] }
      ]
    },
    {
      "action": "Press **Tab**",
      "moment": "action",
      "probes": [
        { "name": "error marker", "x": 400, "y": 140, "rgb": [204, 0, 0] }
      ]
    }
  ]
}
