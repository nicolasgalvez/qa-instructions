{
  "name": "@qa-instructions/example-derived-steps",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:failing": "node scripts/run-failing.mjs",
    "render": "node scripts/render.mjs qa-runs:qa-steps-out qa-runs/collapse:qa-steps-out/collapse qa-runs/ignore:qa-steps-out/ignore",
    "render:failing": "node scripts/render.mjs qa-runs/failing:qa-steps-out/failing",
    "verify": "node scripts/verify-run.mjs",
    "verify:update-goldens": "node scripts/update-goldens.mjs",
    "e2e:selection": "rm -rf qa-runs-selection && playwright test --config playwright.selection.config.ts && node scripts/verify-selection.mjs",
    "e2e": "pnpm test && pnpm test:failing && pnpm render && pnpm render:failing && pnpm verify && pnpm e2e:selection"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@qa-instructions/cli": "workspace:*",
    "@qa-instructions/fixture-site": "workspace:*",
    "@qa-instructions/playwright": "workspace:*",
    "pngjs": "^7.0.0"
  }
}
