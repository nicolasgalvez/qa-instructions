{
  "name": "@qa-instructions/example-derived-steps",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "render": "node ../../packages/cli/dist/index.js render qa-runs --format qa-steps --out qa-steps-out",
    "verify": "node scripts/verify-run.mjs",
    "verify:update-goldens": "node scripts/update-goldens.mjs",
    "e2e:selection": "rm -rf qa-runs-selection && playwright test --config playwright.selection.config.ts && node scripts/verify-selection.mjs",
    "e2e": "pnpm test && pnpm render && pnpm verify && pnpm e2e:selection"
  },
  "devDependencies": {
    "@qa-instructions/cli": "workspace:*",
    "@qa-instructions/fixture-site": "workspace:*",
    "@qa-instructions/playwright": "workspace:*",
    "@playwright/test": "^1.63.0"
  }
}
