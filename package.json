{
  "name": "qa-instructions",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky",
    "example": "pnpm --filter @qa-instructions/example-basic test",
    "example:render": "pnpm --filter @qa-instructions/example-basic render",
    "verify": "pnpm --filter @qa-instructions/example-verification e2e && pnpm --filter @qa-instructions/example-derived-steps e2e && pnpm --filter @qa-instructions/example-derived-steps-1.56 e2e"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.48.0"
  },
  "version": "1.0.0"
}
