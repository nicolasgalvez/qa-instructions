{
  "name": "@procyon-creative/qa-instructions",
  "version": "2.0.0",
  "description": "Derives QA Instructions (steps a human tester follows, with screenshots) from Playwright test runs.",
  "author": "Procyon Creative Services",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/procyon-creative/qa-instructions.git",
    "directory": "packages/qa-instructions"
  },
  "homepage": "https://github.com/procyon-creative/qa-instructions#readme",
  "bugs": {
    "url": "https://github.com/procyon-creative/qa-instructions/issues"
  },
  "keywords": [
    "playwright",
    "playwright-reporter",
    "qa",
    "manual-testing",
    "test-steps",
    "screenshots",
    "reporter"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/core/index.js",
    "./playwright": "./dist/playwright/index.js"
  },
  "bin": {
    "qa-instructions": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "node --test dist-test/test/*/*.test.js"
  },
  "dependencies": {
    "css-select": "^6.0.0",
    "css-what": "^7.0.0",
    "domhandler": "^5.0.3",
    "domutils": "^3.2.2",
    "fflate": "^0.8.3",
    "minimatch": "^10.2.6",
    "sharp": "^0.35.4"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.53.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/pngjs": "^6.0.5",
    "htmlparser2": "^10.1.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist"
  ]
}
